# Runtime settings read by voice_agent.settings.load_settings() from the process environment.
# The app does not load this file itself: export the variables in your shell, or load them with your process manager.
# Every variable is optional; the values below are the defaults.

# OpenAI-compatible chat endpoint (Ollama's default shown).
VOICE_AGENT_LLM_BASE_URL=http://127.0.0.1:11434/v1
VOICE_AGENT_LLM_MODEL=voice-agent
# Placeholder. Set a real key only for a hosted provider.
VOICE_AGENT_LLM_API_KEY=local

# Live web search grounding for interruption answers (0, false or no disables it).
VOICE_AGENT_WEB_SEARCH=true

# Initial prompt for Whisper decoding; a few names or terms bias recognition. Empty means none.
VOICE_AGENT_STT_INITIAL_PROMPT=

# Speech backend tried first: edge (needs internet), pyttsx3 (local SAPI/espeak) or pocket (optional pocket extra).
# The other backends are the fallbacks.
VOICE_AGENT_TTS_PRIMARY=edge

# Speech recognizer: whisper (default) or moonshine (optional moonshine extra). The server still uses Whisper for now.
VOICE_AGENT_STT_BACKEND=whisper
# Folder holding the Moonshine Tiny English int8 model files, used only when the moonshine backend is chosen.
VOICE_AGENT_MOONSHINE_MODEL_DIR=models/stt/moonshine-tiny-en-int8

# Seconds the app waits for you after an interruption before it goes back to what it was doing.
# The wait is extended while you are speaking. After a click on Speak, it starts when you click Stop,
# or after 30 seconds.
VOICE_AGENT_BARGE_IN_LISTEN_S=8.0
